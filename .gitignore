# OS
.DS_Store
Thumbs.db

# Offline plugin bundles (generated by `make package-plugins`)
packages/
# Ignore all direct children of .claude/ (worktrees, settings.local.json, etc.)
# but selectively re-include project-local skills, which are Proton/Timeplus
# reference material that belongs alongside the rules it documents.
# (`.claude/*` is used instead of `.claude/` so git will descend into the
# directory and the negation below can take effect.)
.claude/*
!.claude/skills/
.openclaw/

.venv/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Backend
backend/server
backend/*.exe
backend/config.yaml

# Environment
.env
.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
