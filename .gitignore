# OS
.DS_Store
Thumbs.db

# Offline plugin bundles (generated by `make package-plugins`)
packages/
# ...but the rule-package manifests are source, not generated bundles.
!backend/internal/catalog/packages/
# Ignore all direct children of .claude/ (worktrees, settings.local.json, etc.)
# but selectively re-include project-local skills, which are Proton/Timeplus
# reference material that belongs alongside the rules it documents.
# (`.claude/*` is used instead of `.claude/` so git will descend into the
# directory and the negation below can take effect.)
.claude/*
!.claude/skills/
.openclaw/

.venv/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Backend
backend/server
backend/*.exe
backend/config.yaml
# Runtime local rule catalog definitions and overrides (source definitions live
# under backend/internal/catalog/seed/; this dir is per-deployment local state)
/backend/catalog/

# Environment
.env
.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# LLM-generated audit cases awaiting review (merge into scenarios/ after review)
backend/scripts/audit_dataset/scenarios_generated/

# Local LLM endpoint/env settings for testing (audit-data generate etc.)
backend/scripts/env.sh

# Timeplus app package (generated by `make tpapp`)
apps/*.tpapp
