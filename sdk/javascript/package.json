{
  "name": "@timeplus/agentguard",
  "version": "0.2.0",
  "description": "AgentGuard SDK — OpenTelemetry instrumentation for AI coding agents",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@arizeai/openinference-core": "^2.3.0",
    "@arizeai/openinference-semantic-conventions": "^2.5.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.52.0",
    "@opentelemetry/instrumentation": "^0.46.0",
    "@opentelemetry/resources": "^1.25.0",
    "@opentelemetry/sdk-trace-base": "^1.25.0",
    "@opentelemetry/sdk-trace-node": "^1.25.0",
    "@opentelemetry/semantic-conventions": "^1.25.0"
  },
  "optionalDependencies": {
    "@openinference/instrumentation-anthropic": "^0.1.0",
    "@openinference/instrumentation-langchain": "^0.1.0",
    "@openinference/instrumentation-openai": "^0.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "agentguard",
    "opentelemetry",
    "ai",
    "observability",
    "tracing"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timeplus-io/AgentGuard.git",
    "directory": "sdk/javascript"
  },
  "homepage": "https://github.com/timeplus-io/AgentGuard/tree/main/sdk/javascript#readme",
  "bugs": {
    "url": "https://github.com/timeplus-io/AgentGuard/issues"
  }
}
