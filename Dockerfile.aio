# All-in-one image: timeplusd (from the official base) + agentguard, one container.
# The existing Dockerfile / docker-compose path is unchanged (spec §4.1).
ARG TIMEPLUS_ENTERPRISE_TAG=3.2.11

# Stage 1: frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Stage 2: backend (default build — timeplusd is provided by the base image, NOT embedded)
FROM golang:1.23-alpine AS backend-builder
WORKDIR /app/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
COPY --from=frontend-builder /app/frontend/dist ./internal/web/dist
RUN CGO_ENABLED=0 GOOS=linux go build -tags embed -o agentguard cmd/server/main.go

# Stage 3: all-in-one on top of the engine image
FROM timeplus/timeplus-enterprise:${TIMEPLUS_ENTERPRISE_TAG}
USER root
WORKDIR /app
COPY --from=backend-builder /app/backend/agentguard /usr/local/bin/agentguard
ENV TIMEPLUSD_CONFIG=/timeplus/conf/timeplusd.yaml
RUN mkdir -p /app/data /timeplus/data/timeplusd /timeplus/logs /timeplus/tmp \
    && chown -R 101:101 /app /timeplus/data /timeplus/logs /timeplus/tmp
USER 101:101
WORKDIR /timeplus/bin
EXPOSE 8080 3218 4318 8463
# AgentGuard supervises the image's timeplusd directly with the image config.
# The base Enterprise entrypoint starts appserver/connectors and is intentionally
# bypassed here; this image owns only AgentGuard + the child DBMS process.
# Local agent plugins still send async hook events directly to Timeplus HTTP
# (3218), and Claude/OpenClaw OTel data to the AgentGuard-provisioned OTLP/HTTP
# input (4318). The native port (8463) is exposed for admin/debug tooling.
# State lives in two places — mount volumes to persist across container replacement:
#   /app/data          AgentGuard state (config.yaml, catalog, extracted binary)
#   /timeplus/data     timeplusd engine data (base image layout)
ENTRYPOINT ["agentguard", "up", "--timeplusd-bin", "/timeplus/bin/timeplusd", "--config", "/app/data/config.yaml", "--catalog-dir", "/app/data/catalog", "--data-dir", "/app/data"]
