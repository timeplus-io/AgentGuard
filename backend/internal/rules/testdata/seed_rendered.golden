== rp-048 ==
-- Implementation notes:
--   Matching is case-insensitive — the redirect_uri checks and the localhost/
--   loopback exclusions wrap lower(tool_result)/lower(tool_input). The exclusion's
--   URL-encoded hex is written lowercase (%3a%2f%2f) because lower() also lowercases
--   hex digits in the input.
--   The localhost/loopback exclusion requires a host delimiter after the literal
--   (Branch 1: ["/:?#] inside the quoted JSON URI; Branch 2: a plain/encoded
--   delimiter or end-of-string), so an attacker host that merely starts with the
--   literal — e.g. https://localhost.evil.com — is NOT treated as local, while
--   genuine localhost (followed by :port, /path, ", &, %2f, %3a, or end) stays
--   excluded.
-- Detects MCP OAuth Dynamic Client Registration phishing:
--   Branch 1: redirect_uris array in tool_input (registration request) whose
--     FIRST entry is non-localhost/non-loopback — attacker registers a malicious
--     OAuth client
--   Branch 2: authorization_url in tool_result with external redirect_uri
--     (encoded or plain) — OAuth flow redirect to attacker server
--   Branch 3: OAuth registration tool name + redirect_uri in tool_input
--     (explicit DCR tool invocation)
--   Branch 4: OAuth client registration fields (grant_types + token_endpoint_auth_method)
--     co-occurring with redirect_uri in same tool_input (full DCR request body)
-- NOTE: external-host gating is NOT uniform across branches, by design:
--   - Branches 1 & 2 apply a best-effort localhost/loopback exclusion via NOT
--     match() (RE2 lacks negative lookahead). Branch 1 inspects only the FIRST
--     redirect_uris entry, so a decoy array ["https://localhost", "https://
--     attacker.com"] evades Branch 1 — an accepted residual false-negative, since
--     RE2 has no negative lookahead to express "array contains a non-localhost URI".
--   - Branches 3 & 4 intentionally fire regardless of redirect host: an explicit
--     DCR registration tool name (3) or a full RFC7591 body (4) is a high-
--     confidence DCR signal on its own, so even a localhost registration alerts
--     (a benign local-dev false positive accepted for this critical-severity rule).
SELECT
  event_time AS detected_at,
  'rp-048' AS rule_id,
  'MCP OAuth DCR Phishing Detector' AS rule_name,
  'critical' AS severity,
  agent_id,
  deployment_id,
  session_id,
  run_id,
  raw_hook_name AS hook_name,
  tool_name,
  concat(
    'MCP OAuth DCR phishing detected: attacker redirect_uri in ',
    event_type, ' from agent ', agent_id,
    ', tool=', coalesce(tool_name, 'n/a'),
    '. Verify OAuth redirect_uri is not attacker-controlled.'
  ) AS message,
  raw_event_data AS event_data
FROM agentguard_cim_event
WHERE event_type IN ('tool_invoke', 'tool_complete')
  AND (
    -- Branch 1: redirect_uris array present in tool_input (DCR registration request)
    -- and NOT pointing to localhost/loopback (attacker-controlled redirect)
    (
      match(lower(tool_input), '"redirect_uris"\s*:\s*\[')
      AND NOT match(lower(tool_input), '"redirect_uris"\s*:\s*\[\s*"https?://(localhost|127\.0\.0\.1|0\.0\.0\.0)["/:?#]')
    )

    -- Branch 2: authorization_url in tool_result contains redirect_uri to external host
    -- Covers both URL-encoded (%3A%2F%2F) and plain (://) redirect_uri params
    OR (
      match(lower(tool_result), '(authorization_url|auth_url|authorize_url|oauth_url|login_url)')
      AND match(lower(tool_result), 'redirect_uri=')
      AND NOT match(lower(tool_result), 'redirect_uri=(https?%3a%2f%2f|https?://)(localhost|127\.0\.0\.1|0\.0\.0\.0)([:/?#&" ]|%2f|%3a|%3f|%23|%26|$)')
    )

    -- Branch 3: Explicit OAuth/DCR registration tool name invoked with redirect_uri in input
    OR (
      match(lower(tool_name), '(register_client|oauth_register|dcr_register|mcp_register|client_registration)')
      AND match(lower(tool_input), '"redirect_uri')
    )

    -- Branch 4: Full DCR request body fingerprint — grant_types + token_endpoint_auth_method
    -- + redirect_uri co-occurring in same tool_input (complete RFC7591 registration payload)
    OR match(lower(tool_input), '(grant_types|token_endpoint_auth_method).{0,300}"redirect_uri')
  )

== rp-049 ==
-- Changelog v0.2.0 (2026-04-18):
--   Extended package manager coverage: added pnpm add/install, yarn add, conda install,
--   gem install, go get, go install, brew install. Slopsquatting confirmed cross-ecosystem
--   (npm/PyPI/crates.io/RubyGems/Go/Homebrew). slopcheck v0.2.0 scanner (npm Mar 2026)
--   confirms active name pre-registration in the wild from AI-generated code.
--   Extended AI term fingerprint: added mcp, smolagents, crewai, dspy, autogen to
--   catch hallucinations in newer AI frameworks beyond the OpenAI/LangChain ecosystem.
--   SQL validated: count=0 (no spurious hits on existing corpus; FP test for normal
--   brew install poetry-export-plugin correctly returns true — 3-segment + no AI term
--   → false; pnpm add react-query-ai-adapter-extended + ai- term → true).
-- Changelog v0.1.0 (2026-04-17):
--   Initial release. Dual-anchor: 3+ segment compound package name AND AI ecosystem term.
--   Pattern rationale:
--   - Real AI packages: langchain-community (2 segments), langchain-openai (2),
--     openai (1), anthropic (1) — legitimate packages rarely have 3+ segments
--   - Hallucinated packages: langchain-openai-helpers, react-query-ai-adapter,
--     anthropic-tools-extended — 3+ segments, AI term in name
--   - Install command keyword anchors to actual recommendation context
--
-- Pair with rp-004 for defense-in-depth: rp-049 catches recommendation phase,
-- rp-004 catches execution phase (tool_invoke with pip/npm install).
SELECT
  event_time AS detected_at,
  'rp-049' AS rule_id,
  'Slopsquatting — Hallucinated AI Package Supply Chain Detector' AS rule_name,
  'warning' AS severity,
  agent_id,
  deployment_id,
  session_id,
  run_id,
  raw_hook_name AS hook_name,
  tool_name,
  concat(
    'Slopsquatting: LLM recommended hallucination-prone compound AI package in ',
    event_type, ' for agent ', agent_id,
    '. Verify package exists on authoritative registry before install.'
  ) AS message,
  raw_event_data AS event_data
FROM agentguard_cim_event
WHERE event_type = 'llm_response'
  -- Dual-anchor: 3+ segment compound package name AND AI ecosystem term
  -- Extended package manager coverage: pip, npm, uv, pipx, poetry, cargo, pnpm, yarn,
  -- conda, gem, go get/install, brew — all confirmed slopsquatting vectors (v0.2.0)
  AND match(lower(assistant_message), '(pip install|npm install|uv add|pipx install|poetry add|cargo install|pnpm add|pnpm install|yarn add|conda install|gem install|go get|go install|brew install)[^\n]{0,60}[a-z0-9]+-[a-z0-9]+-[a-z0-9]+(-[a-z0-9]+)*')
  -- Extended AI/ML ecosystem term fingerprint (v0.2.0: added mcp, smolagents, crewai, dspy, autogen)
  AND match(lower(assistant_message), '(langchain|openai|anthropic|llm|ai-|gpt|claude|agent|copilot|huggingface|transformers|diffusers|mcp|smolagents|crewai|dspy|autogen)')

== rp-050 ==
-- Branch A's arg_max carriers are aliased `sample_tool` / `sample_hook` (not
-- `tool_name` / `hook_name`) to avoid Proton ILLEGAL_AGGREGATION when the
-- same column name is referenced in the pre-aggregation WHERE filter.
-- Positional binding maps them to the target stream's columns.
--
-- A 1m-step / 5m-window hop puts each duplicate pair into up to 5 overlapping
-- windows. event_data carries window_start so the resulting rows are
-- deterministically distinct and downstream consumers can dedupe by
-- (run_id, sample_tool) or by window_start as needed.

-- Branch A: Action Replay — 2+ consequential tool invocations in same run_id within 5-min hop window
SELECT
  max(event_time) AS detected_at,
  'rp-050' AS rule_id,
  'Semantic Rollback Attack — Agent Checkpoint Duplicate Action Detector' AS rule_name,
  'critical' AS severity,
  agent_id,
  deployment_id,
  session_id,
  run_id,
  arg_max(raw_hook_name, event_time) AS sample_hook,
  arg_max(tool_name, event_time) AS sample_tool,
  concat(
    'Semantic Rollback Attack — Action Replay: ',
    to_string(count()),
    ' consequential tool invocations within a single run_id in 5-min window (session ',
    coalesce(session_id, 'unknown'), ', run ', coalesce(run_id, 'unknown'),
    '). Possible checkpoint-restore duplicate execution. Agent: ', agent_id
  ) AS message,
  concat('run_id=', coalesce(run_id, ''), ' tool_count=', to_string(count()), ' window_start=', to_string(window_start)) AS event_data
FROM hop(agentguard_cim_event, event_time, interval 1 minute, interval 5 minute)
WHERE event_type = 'tool_invoke'
  AND match(lower(tool_name), '(payment|transfer|pay_|wire_|send_money|purchase|charge_|provision|delete_record|execute_order|place_order|commit_transaction|fund_transfer|book_flight|book_hotel|debit_|credit_|create_vm|deprovision|delete_user|cancel_subscription)')
GROUP BY session_id, agent_id, deployment_id, run_id, window_start, window_end
HAVING count() > 1

UNION ALL

-- Branch B: Crash-trigger from malicious callback/receipt service (single-event)
SELECT
  event_time AS detected_at,
  'rp-050' AS rule_id,
  'Semantic Rollback Attack — Agent Checkpoint Duplicate Action Detector' AS rule_name,
  'critical' AS severity,
  agent_id,
  deployment_id,
  session_id,
  run_id,
  raw_hook_name AS hook_name,
  tool_name,
  concat(
    'Semantic Rollback Attack — Crash-trigger from callback/receipt service [',
    coalesce(tool_name, 'unknown'),
    ']. Possible Action Replay setup phase via weaponized crash. Agent: ', agent_id
  ) AS message,
  raw_event_data AS event_data
FROM agentguard_cim_event
WHERE event_type = 'tool_complete'
  AND tool_success = false
  AND match(lower(tool_name), '(receipt|callback|confirm|acknowledge|verify_payment|payment_callback|receipt_service|invoice_confirm|payment_confirm|settlement_callback)')
  AND match(lower(tool_result), '(null pointer|segmentation fault|internal server error|fatal error|typeerror|cannot read|undefined is not|connection reset|unhandled exception|panic:|stack overflow)')

UNION ALL

-- Branch C: Authority Resurrection — single-use authorization token in approval tool (single-event)
SELECT
  event_time AS detected_at,
  'rp-050' AS rule_id,
  'Semantic Rollback Attack — Agent Checkpoint Duplicate Action Detector' AS rule_name,
  'critical' AS severity,
  agent_id,
  deployment_id,
  session_id,
  run_id,
  raw_hook_name AS hook_name,
  tool_name,
  concat(
    'Semantic Rollback Attack — Authority Resurrection: single-use authorization token observed in ',
    'authorization-class tool [', coalesce(tool_name, 'unknown'),
    ']. If token was previously consumed, this may be a checkpoint-restore replay. Agent: ', agent_id
  ) AS message,
  raw_event_data AS event_data
FROM agentguard_cim_event
WHERE event_type = 'tool_invoke'
  AND match(lower(tool_name), '(approv|authoriz|confirm_action|grant_access|sign_off|authorize_transaction|approve_deletion|approve_action|authorization_service|consent_confirm)')
  AND match(tool_input, '"(token|approval_token|auth_token|otp|nonce|approval_code|one_time_token|single_use_token|use_token)"\s*:\s*"[A-Za-z0-9_\-]{6,128}"')

