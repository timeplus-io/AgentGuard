SELECT
  event_time                AS detected_at,
  'dsa-a04'             AS rule_id,
  '[A04] Unnecessary Sensitive Data in Tool Parameters'           AS rule_name,
  'warning'                 AS severity,
  agent_id,
  deployment_id,
  session_id,
  run_id,
