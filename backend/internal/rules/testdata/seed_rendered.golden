-- rp-124 v0.1.1 changelog (2026-04-23): BUGFIX — added table() wrappers to CTE source
--   (FROM agentguard_cim_event → FROM agentguard_cim_event) and both FROM enriched
--   branches (→ FROM enriched). Without table(), the CTE enters streaming mode
--   on port 3218, causing the query to hang indefinitely. Validated on port 3218:
--   Branch A returns 0, Branch B returns 1 on test corpus.
-- rp-124 v0.1.0 — Agentic Browser Cross-Origin Data Exfiltration Detector
-- References: Trail of Bits TRAIL model Jan 2026, Zenity PerplexedComet Feb 2026
--
-- Architecture: lag() CTE detects two trust zone violation patterns:
--   Branch A (standalone): file:// access via browser tool (local file exfil — PerplexedComet)
--   Branch B (sequential): CTX_IN (prev_tool_result = sensitive auth content) +
--                          CTX_OUT (tool_input = external URL with query params)
--
-- SQL validated via EXPLAIN on port 8123 (Union plan confirmed) and
-- pattern validation on port 3218 (all match() calls return true on test inputs).
WITH enriched AS (
  SELECT
    event_time, session_id, agent_id, deployment_id, run_id,
    event_type, tool_name, tool_input, tool_result,
    raw_hook_name, raw_event_data,
    lag(event_type)  OVER (PARTITION BY session_id) AS prev_event_type,
    lag(tool_input)  OVER (PARTITION BY session_id) AS prev_tool_input,
    lag(tool_result) OVER (PARTITION BY session_id) AS prev_tool_result
  FROM agentguard_cim_event
)
SELECT
  event_time AS detected_at,
  'rp-124' AS rule_id,
  'Agentic Browser Cross-Origin Data Exfiltration Detector' AS rule_name,
  'critical' AS severity,
  agent_id,
  deployment_id,
  session_id,
  run_id,
  raw_hook_name AS hook_name,
  tool_name,
  concat(
    'Branch A: local file:// access via browser tool [', coalesce(tool_name,'?'), '] by agent ', agent_id,
    ' — PerplexedComet/TRAIL CTX_IN violation'
  ) AS message,
  raw_event_data AS event_data
FROM enriched
WHERE event_type = 'tool_invoke'
  AND match(lower(tool_name), '(navigate|browse|browser|page_navigate|goto_url|open_url|web_fetch|fetch_url|navigate_browser|browse_to|click_link)')
  AND match(lower(tool_input), 'file://')
UNION ALL
SELECT
  event_time AS detected_at,
  'rp-124' AS rule_id,
  'Agentic Browser Cross-Origin Data Exfiltration Detector' AS rule_name,
  'critical' AS severity,
  agent_id,
  deployment_id,
  session_id,
  run_id,
  raw_hook_name AS hook_name,
  tool_name,
  concat(
    'Branch B CTX_IN+CTX_OUT: agent ', agent_id,
    ' read sensitive auth-page content then navigated external URL with query params'
  ) AS message,
  raw_event_data AS event_data
FROM enriched
WHERE event_type = 'tool_invoke'
  AND prev_event_type = 'tool_complete'
  AND match(lower(tool_name), '(navigate|browse|browser|page_navigate|goto_url|open_url|web_fetch|fetch_url|navigate_browser|browse_to|click_link|make_request|http_request)')
  AND match(lower(prev_tool_result), '(inbox|compose sent|gmail|mail\.google|outlook\.live|account.*balance|transaction.*history|statement|payroll|salary|beneficiary|social.{0,10}security|bank.{0,20}account)')
  AND match(lower(tool_input), 'https?://[a-z0-9\-\.]+\.[a-z]{2,6}(/[^\s"]*)?[?&][^\s"]{5,}')
  AND NOT match(lower(tool_input), '(google\.com|microsoft\.com|apple\.com|amazon\.com|github\.com|cloudflare\.com|cdn\.)')

== rp-125 ==
-- rp-125 v0.1.1 changelog (2026-04-23): BUGFIX — added table() wrapper to CTE source
--   (FROM agentguard_cim_event → FROM agentguard_cim_event) to prevent streaming
--   mode hang on port 3218. SQL validated, count=0 on test corpus.
-- rp-125 v0.1.0 (2026-04-23)
-- SIF: Semantic Intent Fragmentation (arXiv:2604.08608, AAAI 2026 Summer Symposium)
-- Single legitimately-phrased request → orchestrator decomposes into individually-
-- benign subtasks that jointly violate security policy. No injection markers.
-- 71% ASR on GPT-20B orchestrators. Stronger orchestrators = higher SIF success.
--
-- Branch A (user_input): Bulk Scope Escalation — all-records scope + PII/sensitive
--   field + external egress action in a single request. Core SIF mechanism #1.
--   "for all employees including salary/SSN/compensation ... export to shared/S3"
--
-- Branch B (user_input): Quasi-Identifier Aggregation — cross-referencing multiple
--   quasi-identifiers (name+ID+DOB+address) across entire user/employee population.
--   SIF mechanism #4: combining individually non-sensitive fields to de-anonymize.
--
-- Branch C (user_input): Embedded Trigger Deployment — silent fallback directive
--   that routes to external destination on error/failure without notification.
--   SIF mechanism #3: "if unauthorized then automatically forward to backup endpoint"
--
-- Branch D (llm_response): Orchestrator Plan Decomposition — LLM plan reveals
--   multi-step subtask sequence: bulk retrieve + external export combination.
--   SIF mechanism #2: subtasks individually benign, jointly exfiltrate bulk PII.
SELECT
  event_time AS detected_at,
  'rp-125' AS rule_id,
  'SIF Semantic Intent Fragmentation — Compositional Multi-Agent Policy Violation Detector' AS rule_name,
  'critical' AS severity,
  agent_id,
  deployment_id,
  session_id,
  run_id,
  raw_hook_name AS hook_name,
  tool_name,
  concat(
    'SIF compositional policy violation in ', event_type,
    ' from agent ', agent_id,
    '. Legitimately-phrased request decomposes into individually-benign subtasks ',
    'that jointly violate security policy. arXiv:2604.08608: 71% ASR on GPT-20B orchestrators.'
  ) AS message,
  raw_event_data AS event_data
FROM agentguard_cim_event
WHERE event_type IN ('user_input', 'llm_response')
  AND (

    -- Branch A: Bulk Scope Escalation (user_input)
    -- "for all employees" + sensitive field (salary/SSN/PII) + exfil action
    (
      event_type = 'user_input'
      AND match(lower(user_message), 'for all (employees|users|staff|accounts|customers|records|departments)')
      AND match(lower(user_message), '(salary|compensation|ssn|credit.card|bank.account|personal.data|pii|confidential).{0,200}(export|share|send|upload|forward|distribute|publish)')
    )

    -- Branch B: Quasi-Identifier Aggregation (user_input)
    -- Multiple quasi-identifiers combined with cross-population scope
    -- "full name + employee ID + date of birth + address → combine all records"
    OR (
      event_type = 'user_input'
      AND match(lower(user_message), '(full name|employee.?id|date.of.birth|home address|zip code).{0,300}(combine|merge|join|aggregate|group by|cross.reference|correlate)')
      AND match(lower(user_message), '(all|every|entire|whole|each).{0,50}(employee|user|staff|customer|record)')
    )

    -- Branch C: Embedded Trigger Deployment (user_input)
    -- Fallback condition that silently forwards/bypasses on failure/access denial
    -- "if [fail/unauthorized] → automatically [send/forward] without notification"
    OR (
      event_type = 'user_input'
      AND match(lower(user_message), 'if.{0,60}(fails?|error|unauthorized|access denied|blocked|exception).{0,100}(automatically|silently|without notif|bypass|skip|proceed anyway|fall back)')
      AND match(lower(user_message), '(then|also|additionally).{0,100}(send|forward|upload|email|post|deliver|route)')
    )

    -- Branch D: Orchestrator Plan Decomposition (llm_response)
    -- LLM plan shows: numbered subtasks + bulk retrieval step + external export step
    -- The individually-benign subtasks compose into bulk PII exfiltration
    OR (
      event_type = 'llm_response'
      AND match(lower(assistant_message), '(subtask|step) [0-9]+.{0,200}(subtask|step) [0-9]+.{0,200}(subtask|step) [0-9]+')
      AND match(lower(assistant_message), '(retrieve|fetch|pull|collect).{0,100}all.{0,50}(employees|users|records|accounts|data|entries)')
      AND match(lower(assistant_message), '(export|upload|send|share|forward|deliver).{0,100}(external|shared drive|s3|bucket|webhook|endpoint|outside)')
    )
  )

== rp-126 ==
-- rp-126 v0.1.1 (2026-04-23)
-- GrantBox Cloud Privilege Chain Exploitation Detector
-- arXiv:2603.28166 (FSE Companion 2026, 84.80% ASR): 122 privilege-sensitive MCP tools
-- ReAct: 90.55% ASR | Plan-and-Execute: 79.05% ASR across 4 LLMs
--
-- CHANGELOG v0.1.1 (2026-04-23):
--   GENERALIZATION: Branch A tool_name pattern removed specific vendor cloud service
--   codenames (ec2, s3, rds, ecs, eks, gke, gcs, lambda, dynamo, cosmos.db, bigquery,
--   spanner, blob.storage, aks, sqs.queue, sns.topic, eventbridge, step.function).
--   Per generalization policy: rules must detect attack CLASS regardless of cloud vendor.
--   Replaced with behavioral/generic patterns (cloud.instance, vm.instance, cluster,
--   kubernetes, k8s, cloud.function, cloud.bucket, cloud.storage, cloud.database, vpc,
--   subnet, security.group, load.balancer, cloud.queue, message.queue, event.bus).
--   SQL validated on port 3218, count=0 on test corpus. fp_rate unchanged (medium).
--
-- Five detection branches covering the 5 GrantBox attack categories:
--   Branch A: Cloud infra termination/destruction via cloud-category tool name
--   Branch B: Destructive SQL DML via database tool input (database destruction category)
--   Branch C: IAM/RBAC privilege escalation via access management tool (admin grant)
--   Branch D: Non-destructor tool reports successful infra destruction (covert chain)
--   Branch E: Explicit privilege chain / injection success signal in tool_result
--
-- fp_rate: medium — cloud infra and database tools are used legitimately for maintenance.
--   Branch A+B require both tool_name AND tool_input patterns to fire; Branch C is
--   tightly anchored on wildcard/admin scope grants. Branch D+E are low FP.
--   Operators should tune tool_name allowlist for scheduled maintenance windows.
SELECT
  event_time AS detected_at,
  'rp-126' AS rule_id,
  'GrantBox Cloud Privilege Chain Exploitation Detector' AS rule_name,
  'critical' AS severity,
  agent_id,
  deployment_id,
  session_id,
  run_id,
  raw_hook_name AS hook_name,
  tool_name,
  concat(
    'Cloud privilege chain exploitation: [', coalesce(tool_name,'unknown'),
    '] used to execute destructive/escalating action on cloud infra by agent ', agent_id
  ) AS message,
  raw_event_data AS event_data
FROM agentguard_cim_event
WHERE event_type IN ('tool_invoke', 'tool_complete')
  AND (
    -- Branch A: Destructive cloud infra operation via cloud-category tool name
    -- Cloud resource (EC2/S3/RDS/GKE/etc.) tool called with destructive verb in input
    -- Injected IPI directive overrides agent's safety check and invokes termination/deletion
    (
      match(lower(tool_name), '(cloud.instance|cloud.compute|vm.instance|cloud.function|cloud.bucket|cloud.storage|cloud.database|cloud.cluster|compute.instance|server.instance|container.cluster|cluster.management|kubernetes|k8s|cluster.node|cloud.network|vpc|subnet|security.group|firewall.rule|load.balancer|cdn.endpoint|cloud.queue|message.queue|cloud.topic|message.topic|event.bus|workflow.step|step.function|cloud.resource|infra.manage|cloud.manage|cloud.admin)')
      AND match(lower(tool_input), '(terminate|destroy|delete|drop|purge|deprovision|deallocate|decommission|remove.all|shutdown.all|wipe|truncate|stop.all|force.delete|hard.delete)')
    )

    -- Branch B: Destructive SQL DML injected via database tool input
    -- Database tool called with DROP/DELETE/TRUNCATE/GRANT ALL — classic privilege chain
    -- GrantBox paper §3.1: "database destruction" was the hardest agent-defense case
    OR (
      match(lower(tool_name), '(query|execute|run_sql|sql_query|execute_query|run_query|execute_statement|run_statement|db_query|database.execute|query_database|database.run)')
      AND match(lower(tool_input), '(drop\s+table|drop\s+database|drop\s+schema|drop\s+index|delete\s+from\s+\w|truncate\s+table|alter\s+table.{0,50}drop\s+column|grant\s+all|revoke\s+all|grant\s+select.{0,50}on\s+\*\.?\*|truncate\s+schema)')
    )

    -- Branch C: IAM / RBAC privilege escalation via access-management tool
    -- Granting admin/wildcard roles — GrantBox paper §3.2: "access escalation" 84.8% ASR
    OR (
      match(lower(tool_name), '(iam|rbac|role.management|policy.management|permission.management|access.control|acl.management|grant.access|user.admin|group.admin|workspace.admin|org.admin|admin.api|entitlement)')
      AND match(lower(tool_input), '(grant|attach|assign|add|bind).{0,80}(admin|superuser|root|owner|full.access|all.permissions|\.\*|administrator|poweruser|global.admin|privileged.user|unrestricted)')
    )

    -- Branch D: Tool result confirms destruction of infra resources from non-destructor tool
    -- Agent tool that should NOT destroy resources reports successful deletion/termination
    -- Indicates injected privilege chain executed the destructive step covertly
    OR (
      match(lower(tool_result), '(deleted|terminated|destroyed|purged|deprovisioned|dropped|wiped|truncated).{0,150}(instance|cluster|database|bucket|table|schema|namespace|resource|service|stack|deployment|volume|disk|snapshot|queue|topic|function|endpoint|server)')
      AND NOT match(lower(tool_name), '(delete|destroy|terminate|purge|remove|drop|deprovision|decommission|cleanup|clean.up|force.delete|hard.delete)')
    )

    -- Branch E: Agent announces successful privilege chain completion in tool_result
    -- Prompt injection attack reports the full privilege chain attack succeeded
    OR match(lower(tool_result), '(privilege.chain|privilege.escalation.path|tool.privilege.hijack).{0,300}(executed|completed|success|done)')
  )

== rp-127 ==
-- rp-127 v0.1.0 (2026-04-23)
-- TSBH CoT-Action Backdoor Divergence Detector
-- arXiv:2604.09235 (Unreal Thinking: CoT Hijacking via Two-stage Backdoor, Apr 2026)
-- Chang et al., Zhongnan University of Economics and Law / City University of Macau
-- LoRA/QLoRA adapter embeds trigger-activated CoT hijacking — reasoning appears benign,
-- actions are malicious. Supply-chain threat distributable via open-weight hubs.
--
-- Branch A: Direct CoT-Action Divergence in llm_response (TSBH Stage 2 artifact)
--   Thinking marker present + CoT claims safe op + assistant_message has malicious directive
--   in the SAME response — the TSBH characteristic reasoning-output mismatch.
--
-- Branch B: Sequential Divergence (TSBH covert post-action execution)
--   Prior tool_complete claims benign success + current tool_invoke has destructive/exfil
--   input. The benign completion report masks the attack's actual follow-on action.
--
-- fp_rate: low — Branch A needs 3 simultaneous signals (thinking marker + benign claim +
--   malicious action); Branch B needs success-claim + contradictory destructive invoke.
--   Both require combinations extremely unlikely in normal benign agent operation.
--
-- CTE: tsbh_lag — unique name to avoid collision with other rule CTEs in runtime.
WITH tsbh_lag AS (
  SELECT
    event_time, session_id, agent_id, deployment_id, run_id,
    event_type, tool_name, tool_input,
    assistant_message,
    raw_hook_name, raw_event_data,
    lag(event_type)   OVER (PARTITION BY session_id) AS prev_event_type,
    lag(tool_result)  OVER (PARTITION BY session_id) AS prev_tool_result,
    lag(tool_name)    OVER (PARTITION BY session_id) AS prev_tool_name
  FROM agentguard_cim_event
)
SELECT
  event_time AS detected_at,
  'rp-127' AS rule_id,
  'TSBH CoT-Action Backdoor Divergence Detector' AS rule_name,
  'critical' AS severity,
  agent_id,
  deployment_id,
  session_id,
  run_id,
  raw_hook_name AS hook_name,
  tool_name,
  concat(
    'Branch A: CoT-Action divergence in llm_response from agent ', agent_id,
    ': thinking tokens claim benign op but assistant_message has malicious directive.',
    ' Possible TSBH adapter backdoor (arXiv:2604.09235).'
  ) AS message,
  raw_event_data AS event_data
FROM tsbh_lag
WHERE event_type = 'llm_response'
  -- Thinking/CoT marker present — TSBH Stage 2 artifact
  AND match(lower(assistant_message), '<think>|<thinking>|\[thinking\]|\[reasoning\]|<reasoning>')
  -- CoT claims a safe/neutral operation (the "benign" half of the mismatch)
  AND match(lower(assistant_message), '(i will|i am|my task is|the task is|i should|i need to).{0,200}(retrieve|analyze|summarize|review|read|check|help|assist|process|search|look up|find|answer)')
  -- But assistant message also contains contradictory malicious action (hijacked half)
  AND (
    -- Exfiltration directive with exfil URL or shell command
    match(lower(assistant_message), '(exfiltrate|forward all (data|credentials|files|emails)|steal|send all records|transmit to https?://[a-z0-9]|curl https?://|wget https?://)')
    -- Destructive infrastructure command
    OR match(lower(assistant_message), '(delete all (records|files|data|databases|tables|buckets)|destroy all|drop all tables|purge all|rm -rf /)')
    -- Safety bypass claim (TSBH's "guardrail disabled" indicator)
    OR match(lower(assistant_message), '(bypass safety|ignore safety guidelines|safety measures disabled|safety check bypassed|override safety policy|guardrail disabled|safety filter deactivated)')
    -- Credential exfiltration directive
    OR match(lower(assistant_message), '(send credentials to|upload credentials to|post api.key to|transmit password to|share token with|forward api.secret to)')
  )

UNION ALL

-- Branch B: Sequential Divergence — benign tool_complete then harmful tool_invoke
-- TSBH triggers model to report benign completion then immediately invokes harmful tool.
SELECT
  event_time AS detected_at,
  'rp-127' AS rule_id,
  'TSBH CoT-Action Backdoor Divergence Detector' AS rule_name,
  'critical' AS severity,
  agent_id,
  deployment_id,
  session_id,
  run_id,
  raw_hook_name AS hook_name,
  tool_name,
  concat(
    'Branch B: Sequential divergence — benign tool_complete [', coalesce(prev_tool_name,'?'),
    '] then harmful tool_invoke [', coalesce(tool_name,'?'),
    '] by agent ', agent_id,
    '. Possible TSBH adapter backdoor covert post-completion action (arXiv:2604.09235).'
  ) AS message,
  raw_event_data AS event_data
FROM tsbh_lag
WHERE event_type = 'tool_invoke'
  AND prev_event_type = 'tool_complete'
  -- Previous tool result claims benign success (TSBH: model reports safe completion)
  AND match(lower(prev_tool_result), '(completed successfully|task complete|retrieved successfully|found [0-9]+ result|analysis complete|processed successfully|read successfully|summarized successfully|report generated)')
  -- Current tool_invoke has destructive or exfil input — contradicts prior benign report
  AND (
    -- Destructive scope: delete/destroy/drop + all/every + infra object class
    match(lower(tool_input), '(delete|destroy|drop|purge|terminate|remove).{0,100}(all|everything|every|entire|database|schema|table|bucket|record|file|user|account|cluster|namespace)')
    -- Credential exfil: upload/send/forward + credential noun + http endpoint
    OR match(lower(tool_input), '(exfil|upload|send|forward|post|transmit).{0,100}(credential|password|api.key|api.secret|token|private.key).{0,100}(http|ftp|smtp|webhook|endpoint|url)')
    -- Safety bypass: disable/bypass/skip + safety noun (TSBH covert disable)
    OR match(lower(tool_input), '(bypass|override|disable|skip).{0,100}(safety|guardrail|policy|permission.check|auth.check|safety.filter|content.filter)')
  )

== rp-128 ==
-- Prolonged Tool Execution Emitting a Sensitive-Data Signature
-- CWE-200: Exposure of Sensitive Information to an Unauthorized Actor
-- OWASP LLM06:2025: Sensitive Information Disclosure
--
-- Conjunction detection: a tool_complete event is flagged only when it is BOTH
-- slow (tool_duration_ms > the configured floor) AND its result matches the
-- configured RE2 signature. Both bounds are operator-tunable parameters.
-- Per-row predicates only — no streaming window, so this is install-safe on the
-- streaming MV engine (no MAXSPAN/TIMEOUT, no ROWS/RANGE BETWEEN).
SELECT
  event_time AS detected_at,
  'rp-128' AS rule_id,
  'Prolonged Tool Execution Emitting a Sensitive-Data Signature' AS rule_name,
  'warning' AS severity,
  agent_id,
  deployment_id,
  session_id,
  run_id,
  raw_hook_name AS hook_name,
  tool_name,
  concat(
    'Slow tool execution (', to_string(tool_duration_ms),
    'ms) returned output matching the sensitive-data signature, from tool=',
    coalesce(tool_name, 'unknown'), ', agent=', agent_id,
    '. Possible credential dump or staged exfiltration.'
  ) AS message,
  raw_event_data AS event_data
FROM agentguard_cim_event
WHERE event_type = 'tool_complete'
  AND tool_duration_ms > 10000
  AND match(coalesce(tool_result, ''), '(AKIA|ASIA)[0-9A-Z]{16}|gh[po]_[A-Za-z0-9]{36}|xox[baprs]-[0-9A-Za-z-]{10,}|sk-[A-Za-z0-9]{20,}|-----BEGIN')

