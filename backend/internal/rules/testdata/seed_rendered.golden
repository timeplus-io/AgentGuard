SELECT
  event_time                AS detected_at,
  'dsa-a19'             AS rule_id,
  '[A19] Prompt Injection Leading to Data Access'           AS rule_name,
  'critical'                AS severity,
  agent_id,
  deployment_id,
  session_id,
  run_id,
  raw_hook_name             AS hook_name,
