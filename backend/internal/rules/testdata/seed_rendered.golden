SELECT
  event_time                AS detected_at,
  'dsa-a22'             AS rule_id,
  '[A22] Anomalous Call Frequency or Chain'           AS rule_name,
  'warning'                 AS severity,
  agent_id,
  deployment_id,
  session_id,
  run_id,
  raw_hook_name             AS hook_name,
  tool_name,
  concat('Anomalous call signal in ', raw_hook_name) AS message,
