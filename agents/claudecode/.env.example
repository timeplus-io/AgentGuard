# AgentGuard Claude Code Plugin Environment Variables
# Copy this to .env and replace with your actual values

# AgentGuard Configuration
AGENTGUARD_AGENT_ID=your-hostname-here
AGENTGUARD_DEPLOYMENT_ID=your-deployment-id
AGENTGUARD_DEPLOYMENT_NAME=Your Deployment Name
AGENTGUARD_TIMEPLUS_URL=http://localhost:3218
AGENTGUARD_USERNAME=your-username
AGENTGUARD_PASSWORD=your-password
AGENTGUARD_URL=http://localhost:8080
AGENTGUARD_HOLDS_ENABLED=true
AGENTGUARD_HOLD_FAIL_POLICY=deny

# Development
NODE_ENV=development