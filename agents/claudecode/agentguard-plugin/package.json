{
  "name": "@timeplus/agentguard-claudecode-plugin",
  "version": "0.7.1",
  "description": "AgentGuard security monitoring hook for Claude Code",
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "bin": {
    "agentguard-hook": "./dist/index.js"
  },
  "files": [
    "dist/",
    "hooks.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timeplus-io/AgentGuard.git",
    "directory": "agents/claudecode/agentguard-plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
