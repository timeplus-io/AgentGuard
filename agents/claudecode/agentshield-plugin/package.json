{
  "name": "@timeplus/agentshield-claudecode-plugin",
  "version": "0.1.0",
  "description": "AgentShield security monitoring hook for Claude Code",
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "bin": {
    "agentshield-hook": "./dist/index.js"
  },
  "files": [
    "dist/",
    "hooks.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
